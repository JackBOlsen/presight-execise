{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src"],
  // Tests are typechecked via tsconfig.test.json but must not reach dist —
  // the production image has no test runner to load them with.
  "exclude": ["src/**/*.test.ts", "src/test/**"]
}
