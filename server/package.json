{
  "name": "presight-server",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "seed": "tsx --disable-warning=ExperimentalWarning src/db/seed.ts",
    "seed:reset": "yarn seed --force",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "~10.1.0",
    "express": "~5.1.0",
    "presight-shared": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "~5.0.1",
    "@types/node": "~24.10.1",
    "tsx": "~4.20.6",
    "typescript": "~5.9.3"
  }
}
