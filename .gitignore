# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js

# yarn (berry) — keep the version pin + patches, ignore the rest
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn/install-state.gz

# testing
/coverage
coverage/

# production
dist/
build/

# tooling caches
.vite/
.nx/
*.tsbuildinfo

# SQLite database — generated by the seeder, never committed
server/data/
*.db
*.db-journal
*.db-shm
*.db-wal

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

link.sh
start.sh
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.parcel-cache
.idea/
